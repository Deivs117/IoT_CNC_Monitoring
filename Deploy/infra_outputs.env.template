# =============================================================================
# infra_outputs.env.template — Plantilla de variables de entorno
#
# Instrucciones:
#   1. Copia este archivo como infra_outputs.env (está en .gitignore).
#   2. Reemplaza todos los valores <PLACEHOLDER> con valores reales.
#   3. Nunca comitas infra_outputs.env al repositorio.
#
# El archivo real es generado automáticamente por 01_infraestructura.sh.
# =============================================================================

# ── Configuración general ──────────────────────────────────────────────────
RG_NAME="rg-cnc-iot"
LOCATION="eastus"

# ── IoT Hub ────────────────────────────────────────────────────────────────
IOT_HUB_NAME="cnc-iot-hub"
IOT_DEVICE_ID="cnc_fresadora_01"

# Cadena de conexión Event Hub-compatible (endpoint de eventos del IoT Hub)
# Obtener con: az iot hub connection-string show --hub-name <hub> --policy-name service
IOTHUB_EVENTS_CONNECTION_STRING="Endpoint=sb://<NAMESPACE>.servicebus.windows.net/;SharedAccessKeyName=service;SharedAccessKey=<KEY>"

# Nombre del Event Hub interno del IoT Hub
# Obtener con: az iot hub show --name <hub> --query "properties.eventHubEndpoints.events.path"
IOT_HUB_EVENTHUB_NAME="iothub-ehub-<hub-name>-<id>"

# Cadena de conexión del servicio IoT Hub (para Direct Methods y C2D)
# Obtener con: az iot hub connection-string show --hub-name <hub> --policy-name service
IOTHUB_SERVICE_CONNECTION_STRING="HostName=<hub>.azure-devices.net;SharedAccessKeyName=service;SharedAccessKey=<KEY>"

# ── Cosmos DB ──────────────────────────────────────────────────────────────
COSMOS_ACCOUNT="cnc-iot-cosmos"
COSMOS_DB="CNCMonitor"
COSMOS_CONTAINER="Telemetry"

# Cadena de conexión primaria de Cosmos DB
# Obtener con: az cosmosdb keys list --name <account> --type connection-strings
COSMOSDB_CONNECTION="AccountEndpoint=https://<account>.documents.azure.com:443/;AccountKey=<KEY>;"

# ── Storage Accounts ───────────────────────────────────────────────────────
FUNC_STORAGE="cnciotfunc<hash>"
FRONTEND_SA="cnciotfront<hash>"

# Cadena de conexión del storage de Functions (AzureWebJobsStorage)
FUNC_STORAGE_CONN="DefaultEndpointsProtocol=https;AccountName=<storage>;AccountKey=<KEY>;EndpointSuffix=core.windows.net"

# ── Function App ───────────────────────────────────────────────────────────
FUNC_APP_NAME="cnc-iot-func"
FUNC_BASE_URL="https://<func-app-name>.azurewebsites.net/api"

# Clave de acceso para endpoints con authLevel: function
# Obtener con: az functionapp keys list --name <app> --query "functionKeys.default"
FUNC_KEY="<function-host-key>"

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL="https://<storage-account>.z13.web.core.windows.net"

# ── Telegram Bot ───────────────────────────────────────────────────────────
# Crear bot en @BotFather; obtener chat_id con @getidsbot
TELEGRAM_BOT_TOKEN="<bot-token>"
TELEGRAM_CHAT_ID="<chat-id>"

# ── Umbrales de alerta (opcionales — valores por defecto en el código) ──────
TEMP_MIN="15.0"
TEMP_MAX="45.0"
HUM_MIN="20.0"
HUM_MAX="80.0"
VIBRATION_ANOMALY_THRESHOLD="0.80"
