#pragma once

// =============================================================================
// config.h.template — Plantilla de configuración del nodo CNC principal
// =============================================================================
//
// INSTRUCCIONES:
//   1. Copia este archivo como config.h.
//   2. Rellena los valores con las credenciales reales de tu entorno.
//   3. Nunca commitees config.h con secretos reales.
//   4. Verifica que config.h esté incluido en el .gitignore.
//
// Este archivo contiene solo placeholders y valores de ejemplo.
